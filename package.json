{
  "name": "dsh-weave",
  "version": "0.3.6",
  "description": "远程设备连接与任务：Weave 配对、给其他设备派任务、看进度与会话记录",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/",
    "docs/ADR-001-authoritative-chat-rooms.md",
    "docs/ARCHITECTURE.md",
    "docs/PROTOCOL.md",
    "docs/SECURITY.md",
    "README.md",
    "README.zh.md",
    "RELEASES.md",
    "LICENSE",
    "cordis.patch.yml",
    "docs/assets/"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent",
    "mesh",
    "iroh",
    "p2p",
    "quic",
    "dsh-plugin"
  ],
  "author": "Xiang Bai",
  "contributors": [
    {
      "name": "zddzhangdada",
      "url": "https://github.com/zddzhangdada"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zddzhangdada/dsh-weave.git"
  },
  "bugs": {
    "url": "https://github.com/zddzhangdada/dsh-weave/issues"
  },
  "homepage": "https://github.com/zddzhangdada/dsh-weave#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@number0/iroh": "^1.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && npm test && npm pack --dry-run",
    "test": "node --test test/**/*.test.mjs"
  }
}
